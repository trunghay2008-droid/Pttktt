    print("-" * 80)
    
    test_cases = [1, 2, 5, 10, 50, 100, 500]
    for n in test_cases:
        _, phep_gan, phep_cong = example_with_counters(n)
        cong_thuc = n * (n + 1) // 2
        khop = "HOÀN TOÀN KHỚP" if phep_cong == cong_thuc and phep_gan == cong_thuc + 1 else "Sai lệch"
        print(f"{n:<8} | {phep_cong:<15} | {phep_gan:<18} | {cong_thuc:<20} | {khop}")
    print("=" * 80)
    print("-> Kết luận: Số phép cộng thực nghiệm luôn bằng chính xác n*(n+1)/2.")
    print("-> Số phép gán cho biến sum luôn bằng chính xác n*(n+1)/2 + 1.\n")


