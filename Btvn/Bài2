def example_algorithm(A):
    """
    Cài đặt thuật toán theo đúng đoạn mã giả trong đề bài:
    Algorithm Example(A[1..n])
        sum <- 0
        for i <- 1 to n do
            for j <- 1 to i do
                sum <- sum + A[j]
            end for
        end for
        return sum
    """
    total_sum = 0
    n = len(A)
    for i in range(1, n + 1):          # i chạy từ 1 đến n
        for j in range(1, i + 1):      # j chạy từ 1 đến i
            total_sum = total_sum + A[j - 1] # Index trong Python từ 0
    return total_sum


def example_with_counters(n):
    """
    Mô phỏng thuật toán Example và đếm chính xác số phép gán, phép cộng thực tế
    được thực thi khi n thay đổi.
    """
    # Mảng A kích thước n (giả sử A[k] = 1 với mọi k)
    A = [1] * n
    
    so_phep_gan_sum = 0
    so_phep_cong_sum = 0
    
    # sum <- 0 (1 phép gán ban đầu)
    total_sum = 0
    so_phep_gan_sum += 1
    
    for i in range(1, n + 1):
        for j in range(1, i + 1):
            # sum <- sum + A[j]
            so_phep_cong_sum += 1  # 1 phép cộng
            total_sum = total_sum + A[j - 1]
            so_phep_gan_sum += 1   # 1 phép gán lại vào sum
            
    return total_sum, so_phep_gan_sum, so_phep_cong_sum


